# OPENAI_API_KEY: Required for speech evaluation, kanji extraction, the
# 10-day AI report, and sentence auto-translation. Get one at
# https://platform.openai.com/api-keys. Without it, these features fall
# back to simpler non-AI behavior instead of failing.
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY: Enables the login + cloud save
# feature. Create a free project at https://supabase.com, then copy these
# from Project Settings > API. Run supabase/schema.sql in the SQL Editor once.
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
